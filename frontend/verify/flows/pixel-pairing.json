{
  "name": "pixel-pairing",
  "page": "people",
  "viewports": ["phone", "desktop"],
  "allow_console": ["the server responded with a status of 409 (Conflict)"],
  "steps": [
    { "click": "section[aria-label='Pixels'] >> role=button[name='Add Pixel']" },
    { "fill": { "selector": "role=dialog >> role=textbox[name='Name']", "text": "Pixel 9a" } },
    { "click": "role=dialog >> role=button[name='Add Pixel']" },
    { "expect_text": { "selector": "role=dialog >> role=status", "text": "Waiting for Pixel 9a to connect. Darkroom checks again every few seconds." } },
    { "wait_for": "role=img[name=\"QR code of Darkroom's device ID\"]" },
    { "screenshot": "waiting-nobody" },
    { "click": "role=dialog >> role=button[name='Check now']" },
    { "wait_for": "role=dialog >> role=button[name='This is Pixel 9a']" },
    { "screenshot": "waiting-one" },
    { "click": "role=dialog >> role=button[name='This is Pixel 9a']" },
    { "expect_text": { "selector": "role=dialog", "text": "Approve this device for Pixel 9a?" } },
    { "screenshot": "approving" },
    { "click": "role=dialog >> role=button[name='Approve']" },
    { "expect_text": { "selector": "role=dialog", "text": "Darkroom is sharing Pixel 9a's folder with it." } },
    { "screenshot": "approved" },
    { "click": "role=dialog >> role=button[name='Done']" },
    { "click": "role=button[name=\"Pair Casey's new Pixel\"]" },
    { "click": "role=dialog >> role=button[name=\"This is Casey's new Pixel\"]" },
    { "click": "role=dialog >> role=button[name='Approve']" },
    { "expect_text": { "selector": "role=dialog >> role=alert", "text": "Couldn't pair Casey's new Pixel: that Syncthing device ID is already another Pixel's" } },
    { "scroll_to": "role=dialog >> role=heading[name='2. Approve the Pixel']" },
    { "screenshot": "refused" },
    { "click": "role=dialog >> role=button[name='Pair later']" },
    { "click": "role=button[name='Edit Pixel 9a']" },
    { "click": "role=dialog >> role=button[name='Delete Pixel']" },
    { "click": "role=dialog[name='Delete Pixel 9a?'] >> role=button[name='Delete Pixel']" },
    { "wait_for": "section[aria-label='Pixels'] >> text=Casey's new Pixel" },
    { "screenshot": "put-back" }
  ]
}
