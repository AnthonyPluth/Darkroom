{
  "name": "pixel-unpair",
  "page": "people",
  "viewports": ["phone", "desktop"],
  "steps": [
    { "click": "section[aria-label='Pixels'] >> role=button[name='Add Pixel']" },
    { "fill": { "selector": "role=dialog >> role=textbox[name='Name']", "text": "Pixel 6" } },
    { "click": "role=dialog >> role=button[name='Add Pixel']" },
    { "wait_for": "role=dialog[name='Pair Pixel 6'] >> role=status" },
    { "click": "role=dialog >> role=button[name='Check now']" },
    { "click": "role=dialog >> role=button[name='This is Pixel 6']" },
    { "click": "role=dialog >> role=button[name='Approve']" },
    { "expect_text": { "selector": "role=dialog", "text": "Darkroom is sharing Pixel 6's folder with it." } },
    { "click": "role=dialog >> role=button[name='Done']" },
    { "click": "role=button[name=\"Pair Casey's new Pixel\"]" },
    { "wait_for": "role=dialog >> role=status" },
    { "click": "role=dialog >> role=button[name='Pair later']" },
    { "click": "role=button[name='Edit Pixel 6']" },
    { "wait_for": "role=dialog[name='Edit Pixel'] >> role=button[name='Unpair Pixel 6']" },
    { "screenshot": "paired" },
    { "click": "role=dialog >> role=button[name='Unpair Pixel 6']" },
    { "expect_text": { "selector": "role=dialog[name='Unpair Pixel 6?']", "text": "No photo or file is deleted." } },
    { "screenshot": "confirm" },
    { "click": "role=dialog[name='Unpair Pixel 6?'] >> role=button[name='Unpair']" },
    { "wait_for": "role=button[name='Pair Pixel 6']" },
    { "screenshot": "afterwards" },
    { "click": "role=button[name='Edit Pixel 6']" },
    { "expect_text": { "selector": "role=dialog[name='Edit Pixel'] >> role=group[name='Syncthing']", "text": "Not paired" } },
    { "screenshot": "afterwards-edit" },
    { "click": "role=dialog >> role=button[name='Delete Pixel']" },
    { "click": "role=dialog[name='Delete Pixel 6?'] >> role=button[name='Delete Pixel']" },
    { "wait_for": "section[aria-label='Pixels'] >> text=Casey's new Pixel" },
    { "screenshot": "put-back" }
  ]
}
