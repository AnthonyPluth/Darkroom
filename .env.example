# The image tag compose pulls: the release tag the checkout is at (for example v1.2.3), so the image matches the checkout's seccomp profile; unset pulls latest (docs/deploy/one-container.md)
# DARKROOM_TAG=
PUID=99
PGID=100
DARKROOM_HOST=127.0.0.1
DARKROOM_PORT=8000
DARKROOM_PHOTOS_ROOT=/photos
DARKROOM_DATA_DIR=/data
# Unset: the browser profiles and failure captures are in DARKROOM_PHOTOS_ROOT/_browser. The image sets /data/browser; leave this commented out so it keeps that, and see docs/deploy/browser.md before changing it
# DARKROOM_BROWSER_ROOT=
# DARKROOM_PUBLIC_URL, the OIDC_* settings, IMMICH_URL, RESEND_API_KEY and ALERT_EMAIL_*: a value set here always wins; an empty one falls back to a value stored in Darkroom's database, then to the default. `python run.py check-config` lists where each comes from (docs/runbook.md, Stored settings)
DARKROOM_PUBLIC_URL=https://darkroom.example
# Empty: generated on first start into DARKROOM_DATA_DIR/secret-key (mode 0600) and kept there; set it only to keep the key apart from the data folder. Darkroom refuses to start when sealed values are stored and the key is missing, rather than make a new one
DARKROOM_SECRET_KEY=
# Empty: SQLite in DARKROOM_DATA_DIR. PostgreSQL: postgresql://user:password@host:5432/database (postgres:// and postgresql+psycopg:// also work); see docs/deploy/postgres.md
DATABASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_GROUPS=parents
OIDC_ALLOWED_EMAILS=
DARKROOM_ALLOW_NO_AUTH=
# With DARKROOM_ALLOW_NO_AUTH=1 or the setup wizard's first visitor: host names the browser may use besides IP addresses, localhost and the hosts of DARKROOM_HOST and DARKROOM_PUBLIC_URL, comma-separated (e.g. tower.local); see docs/runbook.md
DARKROOM_ALLOWED_HOSTS=
DARKROOM_DEMO=
# 1 turns on the first-run setup API: before anyone has signed in, the first visitor from a private address (directly, not through a proxy) may store the settings above; see docs/runbook.md
DARKROOM_WIZARD=
IMMICH_URL=
IMMICH_ADMIN_KEY=
# Set only by the one container's init, never by hand: the number of the pipe it hands the generated browser token on (docs/design/single-container.md, section 6)
# DARKROOM_BROWSER_TOKEN_FD=
# Set only by the one container's init, never by hand: the number of the pipe it hands the remote browser view's generated secret on, for the app's relay to noVNC
# DARKROOM_VIEWER_SECRET_FD=
# 1 makes the one container's init start Darkroom's own Syncthing (its home in DARKROOM_DATA_DIR/syncthing), started paused; Darkroom then shares each Pixel's own _pixels folder, Send Only, with the Syncthing device ID on its Pixel record and resumes it once its copies are checked; empty or 0 leaves it off. The one container's compose service and Unraid template set it to 1 (0 there turns it off) and run it on the host's network, with Syncthing on 22000 TCP and UDP and 21027 UDP of every host address (docs/deploy/one-container.md)
DARKROOM_SYNCTHING=
# Set only by the one container's init, never by hand: the number of the pipe it hands Syncthing's API key on, the key it rotates at every start
# DARKROOM_SYNCTHING_KEY_FD=
# Comma-separated alert kinds that never open, and close if open, to roll one back: syncthing_down, syncthing_settings_failed, syncthing_version, share_check_failed, pixel_held; empty keeps them all on
DARKROOM_ALERTS_OFF=
# Set by the one container (its compose service and its init), never by hand: check-config then names a DARKROOM_SYNCTHING=1 set outside it
# DARKROOM_ONE_CONTAINER=
PIXEL_FOLDER_CAP_GB=50
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
POLL_SECONDS=15
BROWSER_CHANNEL=chrome
TZ=UTC
# DARKROOM_BROWSER_TOKEN, DARKROOM_URL, VNC_URL and DARKROOM_VNC_SECRET belonged to the separate browser container, which is gone (#327): the one container
# generates the token and serves the remote browser view itself. Remove them; when one is still set, check-config and the start-up log name it as ignored
