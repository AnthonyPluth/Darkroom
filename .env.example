DARKROOM_DEMO=
IMMICH_URL=
IMMICH_ADMIN_KEY=
DARKROOM_BROWSER_TOKEN=
VNC_URL=
PIXEL_FOLDER_CAP_GB=50
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
