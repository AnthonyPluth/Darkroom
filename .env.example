PUID=99
PGID=100
DARKROOM_HOST=127.0.0.1
DARKROOM_PORT=8000
DARKROOM_PHOTOS_ROOT=/photos
DARKROOM_DATA_DIR=/data
# DARKROOM_PUBLIC_URL, the OIDC_* settings, IMMICH_URL, RESEND_API_KEY and ALERT_EMAIL_*: a value set here always wins; an empty one falls back to a value stored in Darkroom's database, then to the default. `python run.py check-config` lists where each comes from (docs/runbook.md, Stored settings)
DARKROOM_PUBLIC_URL=https://darkroom.example
# Empty: generated on first start into DARKROOM_DATA_DIR/secret-key (mode 0600) and kept there; set it only to keep the key apart from the data folder. Darkroom refuses to start when sealed values are stored and the key is missing, rather than make a new one
DARKROOM_SECRET_KEY=
# Empty: SQLite in DARKROOM_DATA_DIR. PostgreSQL: postgresql://user:password@host:5432/database (postgres:// and postgresql+psycopg:// also work); see docs/deploy/postgres.md
DATABASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_GROUPS=parents
OIDC_ALLOWED_EMAILS=
DARKROOM_ALLOW_NO_AUTH=
# With DARKROOM_ALLOW_NO_AUTH=1: host names the browser may use besides IP addresses, localhost and the hosts of DARKROOM_HOST and DARKROOM_PUBLIC_URL, comma-separated (e.g. tower.local); see docs/runbook.md
DARKROOM_ALLOWED_HOSTS=
DARKROOM_DEMO=
IMMICH_URL=
IMMICH_ADMIN_KEY=
DARKROOM_BROWSER_TOKEN=
VNC_URL=
PIXEL_FOLDER_CAP_GB=50
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DARKROOM_URL=http://darkroom:8000
# The browser worker's viewer refuses every connection without it; Traefik's route sends it (docs/deploy/browser.md, Network)
DARKROOM_VNC_SECRET=
POLL_SECONDS=15
BROWSER_CHANNEL=chrome
TZ=UTC
