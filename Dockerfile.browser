FROM mcr.microsoft.com/playwright/python:v1.49.1-noble

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DISPLAY=:99 PHOTOS_ROOT=/photos POLL_SECONDS=15 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright NOVNC_PORT=6080 VNC_PORT=5900 SCREEN=1280x900x24

RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb x11vnc novnc websockify tini \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/browser/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --break-system-packages --require-hashes -r /tmp/requirements.txt \
    && python -c "import playwright.sync_api; from importlib import metadata; assert metadata.version('playwright') == '1.49.1'" \
    && rm /tmp/requirements.txt

WORKDIR /app
COPY darkroom_browser ./darkroom_browser
COPY deploy/browser/entrypoint.sh /app/entrypoint.sh

RUN useradd --system --uid 10002 --home-dir /home/darkroom-browser --create-home darkroom-browser \
    && mkdir -p /photos /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && chmod 0755 /app/entrypoint.sh \
    && chown -R darkroom-browser /app /home/darkroom-browser

USER darkroom-browser
EXPOSE 6080 5900
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
